# Razvojna podešavanja (server + Docker Compose). Kopiraj u .env: cp .env.example .env
# .env se ne commit-uje; ove vrednosti su samo za lokalni razvoj.

# HTTP server. Isti port koriste docker-compose.yml i klijenti.
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# MySQL. Docker Compose pravi bazu sa ovim podacima i serveru pregazi DB_HOST na "db".
# Za "dart run" u apps/server ostaje 127.0.0.1 (port baze je izložen na DB_PORT).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=terenzo
DB_USER=terenzo
DB_PASSWORD=terenzo_dev_password
DB_ROOT_PASSWORD=terenzo_dev_root_password

# Potpisivanje tokena (HS256). Bar 32 znaka. U produkciji obavezno druga vrednost.
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
JWT_TTL_MINUTES=120

# Porekla kojima pregledač sme da šalje zahteve (backoffice na vebu).
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# Upis početnih podataka pri podizanju (samo za razvoj).
SEED_DEMO_DATA=true
